# ═══════════════════════════════════════════════════════════════════════════════
# KwikID AI Ingest Service — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the required values.
# NEVER commit .env — it contains live secrets.
# Generate API keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# PRODUCTION CHECKLIST:
#   [ ] SUPABASE_URL and SUPABASE_KEY are set
#   [ ] EMBEDDING_API_KEY / OPENAI_API_KEY is set
#   [ ] OPENAI_CHAT_API_KEY is set (or shared with OPENAI_API_KEY)
#   [ ] RAG_API_KEY is set (required — service refuses to start without it)
#   [ ] DEBUG_RAG=false
#   [ ] FASTAPI_DOCS_ENABLED=false
#   [ ] FRESHDESK_WEBHOOK_ENFORCE_HMAC=true (if webhook is enabled)
#   [ ] ACTIVE_INDEX_VERSION matches the index version of your ingested data
# ═══════════════════════════════════════════════════════════════════════════════


# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# CORS — comma-separated list of allowed frontend origins.
# Default is localhost only (dev). Override in production.
CORS_ALLOWED_ORIGINS=https://app.yourcompany.com,https://admin.yourcompany.com


# ─── Document Sources ─────────────────────────────────────────────────────────
# Git repository containing Fumadocs markdown/MDX documentation.
FUMADOCS_REPO_URL=git@bitbucket.org:team360noscope/kwikid-docs-internal.git
FUMADOCS_REPO_BRANCH=main
FUMADOCS_LOCAL_PATH=./data/fumadocs_repo

# File glob for document discovery within the repo.
DOCS_GLOB=**/*.{md,mdx,json}

# Paths for structured data sources (JSON and Excel ingestion).
JSON_DATA_PATH=./data/kwikid
EXCEL_DATA_PATH=./data/excel

# Set to true to ingest ALL sheets from Excel files (default: first sheet only).
EXCEL_INGEST_ALL_SHEETS=false

# Path for Stack Overflow Teams export (More_data/ directory).
# Relative paths resolve from the service root. Use absolute paths in production.
# After repo reorganization, the data lives at: data/raw/More_data/ (4 levels up from service root).
B3_KNOWLEDGE_SOURCE_DIR=../../../../data/raw/More_data


# ─── Embedding ────────────────────────────────────────────────────────────────
# REQUIRED — must match the provider used to index your documents.
# Changing provider after indexing invalidates all existing embeddings.
# Options: openai | ollama (ollama for local dev only)
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1

# SECURITY: Never log or commit this key. Use environment injection in CI/CD.
EMBEDDING_API_KEY=
# Fallback — used if EMBEDDING_API_KEY is not set.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# text-embedding-3-small is the default and recommended (1536 dimensions, cost-effective).
# Change only if you re-index all documents with the new model.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_S=60
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BASE_DELAY_S=0.8


# ─── Phase B1 RAG Engine — Embedding Resilience ───────────────────────────────
# Separate timeout budget for each phase of the HTTP connection.
B1_EMBEDDING_CONNECT_TIMEOUT_S=10
B1_EMBEDDING_READ_TIMEOUT_S=90
B1_EMBEDDING_WRITE_TIMEOUT_S=30
B1_EMBEDDING_POOL_TIMEOUT_S=10

# Retry policy for embedding API calls.
B1_EMBEDDING_MAX_RETRIES=6
B1_EMBEDDING_RETRY_BASE_DELAY_S=1.0
B1_EMBEDDING_RETRY_MAX_DELAY_S=60.0

# Circuit breaker — pauses batch embedding after N consecutive batch failures.
# Prevents cascading failures and unnecessary API spend during outages.
B1_EMBEDDING_CB_THRESHOLD=3
B1_EMBEDDING_CB_COOLDOWN_S=60


# ─── Chunking ─────────────────────────────────────────────────────────────────
# Token-aware chunking (Phase B1.5). OpenAI hard limit is 8192 tokens;
# 7000 gives ~15% safety margin for tokenizer drift.
EMBEDDING_MAX_INPUT_TOKENS=7000

# Target tokens per chunk. 1200 ≈ 900 words. Larger = more context per chunk.
CHUNK_TARGET_TOKENS=1200

# Token overlap between adjacent chunks (prevents context loss at boundaries).
CHUNK_OVERLAP_TOKENS=150

# Word-based chunking parameters (legacy — used when token-aware chunking is unavailable).
MIN_CHUNK_WORDS=200
TARGET_CHUNK_WORDS=350
MAX_CHUNK_WORDS=500
CHUNK_OVERLAP_WORDS=50

# Chunking strategy: auto | paragraph | heading_aware | record_aware
CHUNK_STRATEGY=auto

# Hard character cap per chunk before embedding.
CHUNK_MAX_CHARS=6000

# Minimum words for an orphan (trailing) chunk to be kept (not merged upward).
CHUNK_MIN_ORPHAN_WORDS=50

# Documents shorter than this (chars) are skipped during ingestion.
MIN_DOCUMENT_CHARS=60


# ─── Ingestion Limits ─────────────────────────────────────────────────────────
B1_TICKET_MAX_CHUNK_WORDS=400
B1_TICKET_OVERLAP_WORDS=20
B1_MIN_QUERY_BODY_CHARS=80
B1_MAX_BATCH_ERRORS=10
B1_UPSERT_BATCH_SIZE=50
B1_EMBEDDING_BATCH_SIZE=64

# Path where ingestion run reports are written (JSON + Markdown summaries).
INGEST_REPORTS_PATH=./data/reports

# Parser version tag written into document metadata (for auditing ingest runs).
PARSER_VERSION=v1

# Maximum number of failed batches before an ingestion run aborts.
# 0 = fail on first error (strict). Higher values allow partial success.
INGEST_MAX_BATCH_ERRORS=0

# Git operation timeout (seconds). Increase for large repos or slow networks.
GIT_COMMAND_TIMEOUT_S=120

# Maximum rows loaded into memory for local (offline) matching fallback.
LOCAL_MATCH_FALLBACK_MAX_ROWS=5000

# Metadata tags applied to all documents ingested by this instance.
# Leave blank for single-tenant deployments.
METADATA_TENANT=
METADATA_ACCESS_SCOPE=


# ─── Index Version ────────────────────────────────────────────────────────────
# B1_INDEX_VERSION: the index_version label written by ingestion scripts.
# Keep in sync with ACTIVE_INDEX_VERSION once migration is validated.
# Do NOT use this variable to control retrieval — use ACTIVE_INDEX_VERSION.
B1_INDEX_VERSION=v2

# ACTIVE_INDEX_VERSION: SINGLE SOURCE OF TRUTH for live retrieval.
# /rag/chat and /freshdesk/webhook retrieve from this version.
# Flip to v2 after validating reingest_v2.py output, then restart.
ACTIVE_INDEX_VERSION=v2

# WRITE_INDEX_VERSION: index_version written by the legacy /ingest endpoint.
WRITE_INDEX_VERSION=v2


# ─── Supabase ─────────────────────────────────────────────────────────────────
# SECURITY: SUPABASE_KEY is the service-role key — it bypasses Row Level Security.
# Use ONLY for ingestion/backend operations. Never expose to browser clients.
# Rotate immediately if accidentally committed. See PRODUCTION_HARDENING.md.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=

# Legacy table name used by the /query and /ingest endpoints.
TABLE_NAME=documents


# ─── API Authentication ───────────────────────────────────────────────────────
# REQUIRED: At least one of RAG_API_KEY or RAG_API_KEYS must be set.
# The service REFUSES TO START if neither is configured.
# All routes except /health, /ready, and /freshdesk/webhook require X-API-Key header.
# SECURITY: Generate strong keys — do not use short or guessable values.
RAG_API_KEY=

# Comma-separated list — supports key rotation without downtime:
# RAG_API_KEYS=key1,key2,key3
# RAG_API_KEYS=


# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Maximum requests per minute per IP for /rag/chat.
RAG_CHAT_RATE_LIMIT=20


# ─── Retrieval — Similarity Thresholds ───────────────────────────────────────
RERANK_ENABLED=true
RERANK_CANDIDATE_MULTIPLIER=4

# Minimum similarity score for a chunk to be included in the result.
CONFIDENCE_MIN_SIMILARITY=0.2
CONFIDENCE_MIN_RERANK=0.05

# Per-source-type similarity thresholds (applied before global threshold).
QUERY_SOURCE_THRESHOLD_FRESHDESK=0.20
QUERY_SOURCE_THRESHOLD_MD=0.20
QUERY_SOURCE_THRESHOLD_JSON=0.20
QUERY_SOURCE_THRESHOLD_EXCEL=0.20

# B1 retrieval defaults.
B1_DEFAULT_TOP_K=10
B1_DEFAULT_SIMILARITY_THRESHOLD=0.27
B1_SOP_SIMILARITY_BOOST=0.15
B1_EXCLUDE_ESCALATION_FROM_AUTO=true


# ─── Hybrid Retrieval Pipeline (semantic + keyword + RRF) ────────────────────
# Master switches — both must be enabled for hybrid mode.
# REQUIRED: run sql/b1_migrations/B1_007_fts_setup.sql and B1_008_fts_rpc.sql first.
B1_HYBRID_RETRIEVAL_ENABLED=true
HYBRID_RETRIEVAL_ENABLED=true

# Semantic search (pgvector).
RETRIEVAL_SEMANTIC_TOP_K=20
RETRIEVAL_SEMANTIC_THRESHOLD=0.0

# Keyword search (PostgreSQL full-text search).
RETRIEVAL_KEYWORD_ENABLED=true
RETRIEVAL_KEYWORD_TOP_K=20
RETRIEVAL_KEYWORD_MIN_TS_RANK=0.0

# Reciprocal Rank Fusion (RRF) — k controls score spread (higher k = less aggressive).
RETRIEVAL_RRF_K=60
RETRIEVAL_FUSION_TOP_K=20
B1_RRF_K=60

# Adaptive RRF (adjusts k based on query complexity — enable after FTS is validated).
RETRIEVAL_ADAPTIVE_RRF_ENABLED=false
RETRIEVAL_RRF_K_MIN=20
RETRIEVAL_RRF_K_MAX=100

# Reranking pass (BM25 by default; cross-encoder if RERANK_CROSS_ENCODER_ENABLED=true).
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_RERANK_TOP_K=5

# Final output limits.
RETRIEVAL_FINAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.2
RETRIEVAL_MIN_RERANK_SCORE=0.05

# Optional cross-encoder reranking (requires: pip install sentence-transformers).
# Falls back to BM25 automatically if model load fails or inference times out.
RERANK_CROSS_ENCODER_ENABLED=false
RERANK_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CROSS_ENCODER_TIMEOUT_S=5.0
RERANK_CROSS_ENCODER_LIMIT=20


# ─── Chat / Generation (Phase B2) ─────────────────────────────────────────────
# SECURITY: Keep OPENAI_CHAT_API_KEY separate from the embedding key in production.
# This allows rotating or rate-limiting each independently.
OPENAI_CHAT_API_KEY=
# Model for RAG response generation. gpt-4o-mini balances cost and quality.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_BASE_URL=https://api.openai.com/v1

CHAT_TIMEOUT_S=60
CHAT_MAX_RETRIES=3
CHAT_RETRY_BASE_DELAY_S=0.8
CHAT_TEMPERATURE=0.2
CHAT_MAX_OUTPUT_TOKENS=800

# IMPORTANT: must be >= ingestion chunk size to prevent silent content truncation.
# SOP chunks ingested at CHUNK_TARGET_TOKENS=1200 are ~5,400 chars.
# Setting this too low (e.g. 1,400) silently drops later SOP steps from LLM context.
# 3,500 chars (~500 words) matches the ingestion target within the 6k token budget.
CHAT_CONTEXT_CHUNK_MAX_CHARS=3500

# Number of prior conversation turns included in the chat history context.
CHAT_HISTORY_TURNS=6

# Supabase table used for persisting chat history per session.
CHAT_HISTORY_TABLE=chat_messages


# ─── Workflow Match Classification ───────────────────────────────────────────
# Classification uses the BOOSTED SOP score (raw cosine + B1_SOP_SIMILARITY_BOOST).
# exact_match  → confident, direct response; automation eligible.
# related_match → related procedure found; limitation statement required.
# weak/no_match → no usable SOP; requires_human=true.
WORKFLOW_EXACT_SIMILARITY=0.55
WORKFLOW_RELATED_SIMILARITY=0.35


# ─── Query Router ─────────────────────────────────────────────────────────────
# Zero-latency keyword-based query classifier.
# Routes queries to: SOP / TROUBLESHOOTING / ESCALATION / BILLING_ACCOUNT /
# TECHNICAL_ERROR / RCA / POLICY_COMPLIANCE / GENERAL_KNOWLEDGE
ENABLE_QUERY_ROUTER=true

# Optional LLM fallback for low-confidence query routing.
# Only fires when deterministic confidence < QUERY_ROUTER_LLM_THRESHOLD.
# Adds ~200-500ms latency per low-confidence query. Keep false unless needed.
QUERY_ROUTER_LLM_ENABLED=false
QUERY_ROUTER_LLM_THRESHOLD=0.35
QUERY_ROUTER_LLM_MODEL=gpt-4o-mini


# ─── Freshdesk — Ticket Export Ingestion ────────────────────────────────────
FRESHDESK_ENABLED=false
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
FRESHDESK_UPDATED_SINCE=
FRESHDESK_PAGE_SIZE=100
FRESHDESK_MAX_PAGES=100
FRESHDESK_MAX_RETRIES=4
FRESHDESK_RETRY_BASE_DELAY_S=1.0

# ─── Sprint 2.29: Freshdesk API write client (response service) ──────────────
# FRESHDESK_DOMAIN and FRESHDESK_API_KEY above are ALSO used by Sprint 2.29 to
# create FreshdeskClient → FreshdeskResponseService at startup.
# Without these, the response service is skipped and routes fall back to offline mode.
# FRESHDESK_TIMEOUT_SECONDS: per-request HTTP timeout for write calls (default 10s).
FRESHDESK_TIMEOUT_SECONDS=10.0


# ─── Sprint 2.12: Action Gateway ─────────────────────────────────────────────
# Set to true to route Freshdesk webhook replies through the action gateway.
# When false (default): direct FreshdeskReplyClient path is used.
# PREREQUISITES before enabling:
#   1. Apply S2_004_drop_case_fk.sql in Supabase SQL editor.
#   2. Confirm S2_001, S2_003 migrations are applied.
#   3. Set AUDIT_BACKEND=supabase.
ACTION_GATEWAY_ENABLED=false

# Background worker poll interval (seconds). Default: 5.
ACTION_WORKER_POLL_INTERVAL_S=5

# SLA watchdog poll interval (seconds). Default: 60.
ACTION_WATCHDOG_POLL_INTERVAL_S=60

# ─── Action Gateway — Audit Backend ──────────────────────────────────────────
# Backend used for storing audit events from the Action Gateway.
# inmemory : events stored in-process, lost on restart (default — safe for dev/test).
# supabase : events persisted to the audit_events table (production).
#            Requires S2_003_dead_letter_and_audit_events.sql migration applied.
#            SUPABASE_URL and SUPABASE_KEY must also be set.
# PRODUCTION CHECKLIST: Set to supabase before first live deployment.
AUDIT_BACKEND=supabase

# Maximum number of events returned per audit API request (GET /audit/*).
# Requests with limit > this value are clamped, not rejected.
AUDIT_QUERY_MAX_LIMIT=500

# ─── Sprint 2.10: Audit Reliability ──────────────────────────────────────────
# Retry policy for failed Supabase audit writes.
# AUDIT_RETRY_ENABLED: set false only in local dev to skip retries.
# AUDIT_MAX_RETRIES: total attempts (1 = no retry). Default: 4.
AUDIT_RETRY_ENABLED=true
AUDIT_MAX_RETRIES=4

# In-process outbox buffer for audit events when all retries are exhausted.
# Events are re-delivered on the next write cycle. Lost on process restart.
# For guaranteed delivery, use a durable broker (Kafka, SQS).
AUDIT_OUTBOX_MAX_SIZE=1000

# ─── Sprint 2.11: Request Correlation ────────────────────────────────────────
# Request IDs are auto-generated (UUID4) if not provided by the caller.
# Clients can supply X-Request-ID header to propagate their own correlation ID.
# No configuration needed — this is always enabled.

# ─── Sprint 2.11: Structured Logging ─────────────────────────────────────────
# Set to true to emit structured JSON logs (for log aggregators).
# When false: standard Python logging format is used.
STRUCTURED_LOGGING_ENABLED=false


# ─── Phase B3: Freshdesk Inbound Webhook ─────────────────────────────────────
# DISABLED until B1 live ingestion is validated end-to-end.
# Set FRESHDESK_WEBHOOK_ENABLED=true only after B1 is stable in production.
FRESHDESK_WEBHOOK_ENABLED=false

# SECURITY: REQUIRED in production. Webhook requests without a valid HMAC signature
# will be rejected. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FRESHDESK_WEBHOOK_SECRET=

# Webhook verification mode:
#   static — Freshdesk sends the raw secret as X-Webhook-Token (dev/direct mode).
#   hmac   — n8n computes HMAC-SHA256(secret, raw_body) before forwarding (production).
# Default: hmac. Set to "static" for Sprint 2.28 direct Freshdesk → backend testing.
FRESHDESK_WEBHOOK_MODE=static

# Default client/tenant tag for webhook-sourced tickets without an explicit tag.
FRESHDESK_WEBHOOK_DEFAULT_CLIENT=

# When true: replies are posted as private Freshdesk notes (recommended for drafts).
# When false: replies are posted as public ticket responses.
FRESHDESK_WEBHOOK_REPLY_AS_NOTE=true

# Minimum confidence level required to send an automated reply.
# Options: low | medium | high
FRESHDESK_WEBHOOK_MIN_CONFIDENCE=low

# Tag prefix used to identify tenant/client from Freshdesk ticket tags.
FRESHDESK_WEBHOOK_TENANT_TAG_PREFIX=client:

# PRODUCTION SAFETY: When true, service REFUSES TO START if webhook is enabled
# but FRESHDESK_WEBHOOK_SECRET is not set. Prevents accidentally skipping HMAC validation.
# MUST be set to true before enabling the webhook in any production environment.
FRESHDESK_WEBHOOK_ENFORCE_HMAC=true

# Sprint 2.28.1: Replay protection window (seconds). Events older than this are rejected.
FRESHDESK_WEBHOOK_REPLAY_WINDOW_SECONDS=300

# Sprint 2.28.1: Freshdesk API rate limit cap (requests per minute).
# Account-wide limit is 40/min; we cap at 30 to leave headroom for human agents.
FRESHDESK_API_RATE_LIMIT_PER_MIN=30


# ─── Redis Rate Limiting ──────────────────────────────────────────────────────
# When disabled (default): per-worker in-process sliding window is used.
# Enable for distributed rate limiting across multiple uvicorn workers.
# Graceful degradation: falls back to in-process if Redis is unreachable.
REDIS_RATE_LIMIT_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_SOCKET_TIMEOUT_S=1.0
REDIS_SOCKET_CONNECT_TIMEOUT_S=0.5


# ─── Prometheus Metrics ────────────────────────────────────────────────────────
# Exposes /metrics endpoint in Prometheus text format.
# PRODUCTION DEFAULT: false. Only enable if you have a Prometheus scraper configured.
PROMETHEUS_ENABLED=true


# ─── FastAPI Docs ────────────────────────────────────────────────────────────
# PRODUCTION DEFAULT: false. Setting true exposes full API schema via /docs,
# /redoc, /openapi.json — these paths are UNPROTECTED (no API key required).
# Only enable in dev/staging environments.
FASTAPI_DOCS_ENABLED=false


# ─── Phase B3: Knowledge Base Tables ──────────────────────────────────────────
B3_KNOWLEDGE_ARTICLES_TABLE=rag_knowledge_articles
B3_KNOWLEDGE_CHUNKS_TABLE=rag_knowledge_chunks
B3_REVIEW_QUEUE_TABLE=rag_review_queue

# Chunks with quality_score below this threshold are excluded from retrieval.
B3_KNOWLEDGE_MIN_QUALITY_SCORE=0.55

# Similarity boost applied to knowledge chunks in match_all_b1_sources RPC.
B3_KNOWLEDGE_SIMILARITY_BOOST=0.08
B3_KNOWLEDGE_QUALITY_BONUS_MAX=0.05

# Minimum character length for a knowledge chunk to be embedded.
B3_KNOWLEDGE_MIN_CHUNK_CHARS=100


# ─── Phase B3: Asana Integration (optional) ───────────────────────────────────
# ASANA_API_KEY=
# ASANA_PROJECT_ID=
# ASANA_WORKSPACE_ID=

# Asana webhook receiver (L2 resolution loop) — POST /webhooks/asana/task-completed.
# Optional: defaults to ./data/asana_webhook_secrets.json if unset. This file
# stores the handshake secret Asana gives us at webhook-registration time and
# is required to verify future event deliveries — do not commit it (see .gitignore).
# ASANA_WEBHOOK_SECRET_STORE_PATH=./data/asana_webhook_secrets.json

# Sprint 2.63.1: ReplySafetyGate emergency kill switch. When set to a truthy
# value, ALL autonomous customer-facing replies (escalation notices, Pass 1/2
# orchestrator replies, Asana resolution closures) are blocked and drafted as
# internal notes instead of sent. Leave unset/false in normal operation.
# REPLY_SAFETY_KILL_SWITCH=false


# ─── Observability & Debugging ────────────────────────────────────────────────
# PRODUCTION DEFAULT: false for all debug flags.

# Emit structured JSON traces for each request to TRACE_DIR.
DEBUG_TRACE=false
TRACE_DIR=./traces
LOG_DIR=./logs

# SECURITY RISK — NEVER enable in production.
# When true: /rag/chat chunk dicts include content_preview (first 800 chars),
# retrieval_rank, and rerank_score. Chunk text may contain PII from ticket history.
DEBUG_RAG=false

# =========================
# Retrieval optimization
# =========================

RETRIEVAL_FTS_TIMEOUT_S=0.4

RETRIEVAL_EARLY_EXIT_SIM_THRESHOLD=0.45
RETRIEVAL_EARLY_EXIT_MIN_CANDIDATES=5

RETRIEVAL_BOOST_RESOLUTION_RCA=0.15
RETRIEVAL_BOOST_QUERY_BODY=0.08
RETRIEVAL_BOOST_ISSUE_HEADER=-0.10

RETRIEVAL_MAX_ISSUE_HEADERS=2


# =========================
# Chat generation
# =========================

CHAT_MAX_OUTPUT_TOKENS=300
CHAT_CONTEXT_CHUNK_MAX_CHARS=800


# =========================
# OpenAI / generation
# =========================

OPENAI_TIMEOUT_S=25


# ═══════════════════════════════════════════════════════════════════════════════
# Sprint 2.8 — Role-Based Authentication (security/config.py + config_validator.py)
# ═══════════════════════════════════════════════════════════════════════════════
# When AUTH_ENABLED=true, the service refuses to start unless at least one of
# APPROVER_API_KEYS / OPERATOR_API_KEYS / ADMIN_API_KEYS is populated.
# When AUTH_ENABLED=false (default), anonymous access is allowed — dev only.
AUTH_ENABLED=false

# Newline- or comma-delimited "<identity>:<api_key>" pairs, one per role.
# Rotate keys by adding new pairs first, then removing old ones — the service
# accepts any pair matching the identity portion.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
APPROVER_API_KEYS=
OPERATOR_API_KEYS=
ADMIN_API_KEYS=


# ═══════════════════════════════════════════════════════════════════════════════
# Sprint 2.50 — Metrics Platform (Uptime Kuma READ-ONLY integration)
# ═══════════════════════════════════════════════════════════════════════════════
# Consumed by metrics_platform/config.py::MetricsPlatformConfig.from_env().
# Integration is READ-ONLY: no write / mutation endpoints are wrapped.
# When METRICS_PLATFORM_ENABLED=false the adapters return DataAvailability=DISABLED
# canonical evidence without making any HTTP calls.

METRICS_PLATFORM_ENABLED=true
METRICS_PLATFORM_BASE_URL=http://status.getkwikid.com:3001
METRICS_PLATFORM_DEFAULT_SLUG=kwikid

# Auth mode: bearer | basic | none. Default: bearer.
# SOT api_reference.md §3.1: `Authorization: Bearer <api_key>` on /metrics only.
METRICS_PLATFORM_AUTH_MODE=bearer

# API key for /metrics endpoint. One of the 3 configured Uptime Kuma keys
# (supportdashboard | script | Support_Automation), or a freshly generated one.
# SOT README notes the shared key returned 401 during audit — verify.
METRICS_PLATFORM_API_KEY=

# Timeouts + retries.
METRICS_PLATFORM_TIMEOUT_S=10
METRICS_PLATFORM_MAX_RETRIES=2

METRICS_PLATFORM_USER_AGENT=KwikID-Support-Automation/2.50 (+metrics)

# Sprint 2.52 — Explicit Prometheus basic-auth credentials.
# When BOTH are set they take precedence over METRICS_PLATFORM_API_KEY for
# the /metrics endpoint (effective_auth_mode becomes "basic" regardless of
# METRICS_PLATFORM_AUTH_MODE). Use this when the Prometheus scrape endpoint
# is a separate service from Uptime Kuma with its own username / password.
# When either is empty the runtime falls back to METRICS_PLATFORM_API_KEY.
METRICS_PROMETHEUS_USERNAME=
METRICS_PROMETHEUS_PASSWORD=


# ═══════════════════════════════════════════════════════════════════════════════
# Sprint 2.51 — Unity Admin Portal (Unity Bank VKYC READ-ONLY integration)
# ═══════════════════════════════════════════════════════════════════════════════
# Consumed by unity/config.py::UnityConfig.from_env().
# Integration is READ-ONLY: no /sendLink/ or any mutation endpoint is wrapped.
# When UNITY_ENABLED=false the 5 production adapters return EvidenceAvailability
# = DISABLED canonical evidence without making any HTTP calls.
# Custom auth header spelling: `auth: <token>` (NOT `Authorization: Bearer`).

UNITY_ENABLED=true
UNITY_BASE_URL=https://vkyc360.unitybank.co.in
UNITY_DOMAIN=unity

# Service-account credentials. SOT integration_notes.md §10: store in AWS
# Secrets Manager at kwikid/unity/vkyc_api_credentials — never hardcode.
# `unity` / `unity` was the discovery-time value; rotate before production.
UNITY_USERNAME=unity
UNITY_PASSWORD=

# Timeouts (seconds).
UNITY_TIMEOUT_CONNECT_S=5
UNITY_TIMEOUT_READ_S=15

# Retries + backoff for 5xx / transient errors.
UNITY_MAX_RETRIES=2
UNITY_RETRY_BACKOFF_S=1.0

# Token proactive-refresh buffer. JWT TTL is 12h (43200s); refresh 2 min early.
UNITY_TOKEN_REFRESH_BUFFER_S=120

UNITY_USER_AGENT=KwikID-Support-Automation/2.51 (+unity)


# ═══════════════════════════════════════════════════════════════════════════════
# Sprint 2.53 Wave 4A — Enterprise Intelligence Layer (LLM Reasoning + Reply)
# ═══════════════════════════════════════════════════════════════════════════════
# Consumed by intelligence/config.py::IntelligenceConfig.from_env().
# Provider-agnostic. When INTELLIGENCE_ENABLED=false, SupportAgentRuntime skips
# LLM entirely and falls back to deterministic templating (ResponseGenerationService).
# The layer NEVER executes actions — it only proposes them (Action Gateway
# is a separate sprint).

INTELLIGENCE_ENABLED=true

# Provider taxonomy. Options: openai | anthropic | azure_openai | mock.
# `mock` returns deterministic canned responses (no HTTP) — use for dev / tests.
INTELLIGENCE_LLM_PROVIDER=openai
INTELLIGENCE_LLM_MODEL=gpt-4o-mini
INTELLIGENCE_LLM_BASE_URL=https://api.openai.com/v1

# API key fallback order: INTELLIGENCE_LLM_API_KEY → OPENAI_CHAT_API_KEY →
# OPENAI_API_KEY. Empty allowed ONLY when provider=mock.
INTELLIGENCE_LLM_API_KEY=

# HTTP + retry budget.
INTELLIGENCE_LLM_TIMEOUT_S=45
INTELLIGENCE_LLM_MAX_RETRIES=2

# Reasoning knobs. Temperature 0.2 gives deterministic-enough structured output.
INTELLIGENCE_LLM_TEMPERATURE=0.2
INTELLIGENCE_LLM_MAX_OUTPUT_TOKENS=1200
INTELLIGENCE_LLM_JSON_MODE=true

# Clarification gate. When reasoning.confidence < threshold, the orchestrator
# routes to a clarification request instead of a resolution reply.
INTELLIGENCE_CONFIDENCE_THRESHOLD=0.75

INTELLIGENCE_USER_AGENT=KwikID-Support-Automation/2.53 (+intelligence)


# ═══════════════════════════════════════════════════════════════════════════════
# Sprint 2.5.6 — NLP Semantic Router (Layer 2.5)
# ═══════════════════════════════════════════════════════════════════════════════
# Consumed by case_engine/nlp_router.py::NLPRouter.
# Replaces all regex/pattern-matching topic classification with an LLM-based
# semantic router that handles negation ("not receiving", "didn't get"),
# extracts investigation entities (URN, Session ID), and returns structured
# NLPSignal output per Blueprint Layer 2.5.
#
# When NLP_ROUTER_ENABLED=false: TopicClassifier falls back to UNKNOWN topic
# and the system uses the clarification engine to gather slots manually.
# When NLP_ROUTER_ENABLED=true: LLM routes intent, extracts entities, and sets
# needs_clarification=true if required investigation slots (URN / Session ID) are absent.
#
# API key fallback order: INTELLIGENCE_LLM_API_KEY → OPENAI_CHAT_API_KEY → OPENAI_API_KEY
# No separate key needed if INTELLIGENCE_LLM_API_KEY is already set above.

NLP_ROUTER_ENABLED=true

# Model for NLP routing. gpt-4o-mini is recommended (cost-effective, structured output).
# Change to gpt-4o for higher accuracy on ambiguous tickets.
NLP_ROUTER_MODEL=gpt-4o-mini

# HTTP timeout (seconds) for the NLP routing LLM call.
NLP_ROUTER_TIMEOUT_S=15


# ═══════════════════════════════════════════════════════════════════════════════
# Sprint 2.5.7 — Support Agent Runtime Mode (Wave 5)
# ═══════════════════════════════════════════════════════════════════════════════
# Controls whether SupportAgentRuntime executes actions or only simulates them.
#
# DRY_RUN (default):   Full investigation + LLM reasoning pipeline runs normally.
#                      Execution is simulated — no external mutations occur.
#                      Asana L2 escalation tickets are NOT created.
#                      Audit events are emitted with DRY_RUN_* prefix.
#                      Safe for staging, load testing, and initial integration.
#
# PRODUCTION:          All pipeline steps execute with real external calls.
#                      Asana L2 escalation tickets ARE created when L2CHECK fires.
#                      Customer-facing replies go live via FreshdeskResponseService.
#
# PREREQUISITES before setting PRODUCTION:
#   1. Observer webhook rule created (customer replies → /webhooks/freshdesk/ticket-updated)
#   2. FRESHDESK_WEBHOOK_SECRET set and FRESHDESK_WEBHOOK_ENFORCE_HMAC=true
#   3. "AI auto replies" Dispatch'r rule extended to Unity Bank tickets
#   4. Dedicated AI agent account provisioned (ai.support@getkwikid.com)
#   5. (Optional) ASANA_API_KEY + ASANA_PROJECT_ID set for L2 escalation tickets

SUPPORT_AGENT_MODE=DRY_RUN


# =============================================================================
# MULTI-TENANT LOG PLATFORM — Grafana Loki (Sprint 2.60)
# Backend log retrieval for VKYC session investigation.
# Credentials are per-tenant. SaaS, Canara, and BOB are all registered in
# LOKI_REGISTRY in client.py. Fill in Canara/BOB credentials below to
# activate those tenants — leaving them blank keeps them registered but
# non-functional (calls will fail with a credentials-rejected error).
# =============================================================================
LOKI_ENABLED=true
LOKI_SAAS_URL=https://utility-server-sfd.app.getkwikid.com
LOKI_SAAS_USERNAME=
LOKI_SAAS_PASSWORD=
LOKI_TIMEOUT=30
LOKI_QUERY_LIMIT=1000

# Canara Loki credentials
LOKI_CANARA_URL=https://videokyc.canarabank.bank.in
LOKI_CANARA_USERNAME=
LOKI_CANARA_PASSWORD=

# BOB Loki credentials
LOKI_BOB_URL=http://43.204.15.162:3000
LOKI_BOB_USERNAME=
LOKI_BOB_PASSWORD=
