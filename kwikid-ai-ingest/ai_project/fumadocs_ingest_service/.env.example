HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

CORS — set to your production frontend domains (comma-separated)
Default is localhost only (dev mode). In production, override with actual domains.
CORS_ALLOWED_ORIGINS=https://app.yourcompany.com,https://admin.yourcompany.com

FUMADOCS_REPO_URL=git@bitbucket.org:team360noscope/kwikid-docs-internal.git
FUMADOCS_REPO_BRANCH=main
FUMADOCS_LOCAL_PATH=./data/fumadocs_repo
DOCS_GLOB=**/*.{md,mdx,json}
JSON_DATA_PATH=./data/kwikid
EXCEL_DATA_PATH=./data/excel
EXCEL_INGEST_ALL_SHEETS=false

# ─── Embedding ────────────────────────────────────────────────────────────────
# REQUIRED — must match the provider used to index your documents.
# Default is 'openai'. Set to 'ollama' only for local dev with Ollama running.
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small  # default when EMBEDDING_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
# SECURITY: Never log or commit this key. Use environment injection in CI/CD.
OPENAI_API_KEY=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_S=60
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BASE_DELAY_S=0.8

# ─── Phase B1 RAG Engine ──────────────────────────────────────────────────────
# Embedding timeouts (separate for DNS vs read vs write)
B1_EMBEDDING_CONNECT_TIMEOUT_S=10
B1_EMBEDDING_READ_TIMEOUT_S=90
B1_EMBEDDING_WRITE_TIMEOUT_S=30
B1_EMBEDDING_POOL_TIMEOUT_S=10

# Retry policy
B1_EMBEDDING_MAX_RETRIES=6
B1_EMBEDDING_RETRY_BASE_DELAY_S=1.0
B1_EMBEDDING_RETRY_MAX_DELAY_S=60.0

# Circuit breaker (pause after N consecutive batch failures)
B1_EMBEDDING_CB_THRESHOLD=3
B1_EMBEDDING_CB_COOLDOWN_S=60

# Chunking
B1_TICKET_MAX_CHUNK_WORDS=400
B1_TICKET_OVERLAP_WORDS=20
B1_MIN_QUERY_BODY_CHARS=80

# Ingestion limits
B1_MAX_BATCH_ERRORS=10
B1_UPSERT_BATCH_SIZE=50
B1_EMBEDDING_BATCH_SIZE=64

# Index version — bump to "v2" to rebuild cleanly without touching v1 rows
B1_INDEX_VERSION=v1

# Retrieval defaults
B1_DEFAULT_TOP_K=10
B1_DEFAULT_SIMILARITY_THRESHOLD=0.27
B1_SOP_SIMILARITY_BOOST=0.15
B1_EXCLUDE_ESCALATION_FROM_AUTO=true

# ─── Token-aware chunking (Phase B1.5) ───────────────────────────────────────
# Hard cap: no chunk sent to the embedding API may exceed this many tokens.
# OpenAI's limit is 8192; 7000 gives ~15% safety margin for tokenizer drift.
EMBEDDING_MAX_INPUT_TOKENS=7000

# Target tokens per chunk. Larger = more context per chunk, fewer chunks total.
# 1200 tokens ≈ 900 words of English prose — good balance for semantic search.
CHUNK_TARGET_TOKENS=1200

# Token overlap between adjacent chunks (prevents context loss at split boundaries).
CHUNK_OVERLAP_TOKENS=150

MIN_CHUNK_WORDS=200
TARGET_CHUNK_WORDS=350
MAX_CHUNK_WORDS=500
CHUNK_OVERLAP_WORDS=50
CHUNK_STRATEGY=auto
CHUNK_MAX_CHARS=6000
CHUNK_MIN_ORPHAN_WORDS=50
MIN_DOCUMENT_CHARS=60
INGEST_REPORTS_PATH=./data/reports
PARSER_VERSION=v1
METADATA_TENANT=
METADATA_ACCESS_SCOPE=
INGEST_MAX_BATCH_ERRORS=0
GIT_COMMAND_TIMEOUT_S=120
LOCAL_MATCH_FALLBACK_MAX_ROWS=5000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# SECURITY: Use the service-role key (bypasses RLS) only for ingestion scripts.
# Never commit the actual key. Never expose this key to browser clients.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=
# Alias accepted by some scripts (same value as SUPABASE_KEY):
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
TABLE_NAME=documents
WRITE_INDEX_VERSION=v1
ACTIVE_INDEX_VERSION=v1
RERANK_ENABLED=true
RERANK_CANDIDATE_MULTIPLIER=4
CONFIDENCE_MIN_SIMILARITY=0.2
CONFIDENCE_MIN_RERANK=0.05
QUERY_SOURCE_THRESHOLD_FRESHDESK=0.20
QUERY_SOURCE_THRESHOLD_MD=0.20
QUERY_SOURCE_THRESHOLD_JSON=0.20
QUERY_SOURCE_THRESHOLD_EXCEL=0.20

FRESHDESK_ENABLED=false
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
FRESHDESK_UPDATED_SINCE=
FRESHDESK_PAGE_SIZE=100
FRESHDESK_MAX_PAGES=100
FRESHDESK_MAX_RETRIES=4
FRESHDESK_RETRY_BASE_DELAY_S=1.0

# ─── Phase B3: Freshdesk webhook inbound (DISABLED until B1 is stable) ────────
# Set FRESHDESK_WEBHOOK_ENABLED=true only after B1 live ingestion is validated.
FRESHDESK_WEBHOOK_ENABLED=false
FRESHDESK_WEBHOOK_SECRET=
FRESHDESK_WEBHOOK_DEFAULT_CLIENT=
FRESHDESK_WEBHOOK_REPLY_AS_NOTE=true
FRESHDESK_WEBHOOK_MIN_CONFIDENCE=low
FRESHDESK_WEBHOOK_TENANT_TAG_PREFIX=client:

# ─── Phase B2.5: API Authentication (REQUIRED for production) ────────────────
# SECURITY: At least one of RAG_API_KEY or RAG_API_KEYS must be set.
# The service REFUSES TO START if neither is configured.
# All routes except /health, /ready, and /freshdesk/webhook require X-API-Key header.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEY=
# Comma-separated list for key rotation without downtime:
# RAG_API_KEYS=key1,key2,key3

# Maximum requests per minute per IP address for /rag/chat (default: 20)
RAG_CHAT_RATE_LIMIT=20

# Expose FastAPI /docs, /redoc, /openapi.json (DISABLE in production)
FASTAPI_DOCS_ENABLED=false

OPENAI_CHAT_API_KEY=
CHAT_TIMEOUT_S=60
CHAT_MAX_RETRIES=3
CHAT_RETRY_BASE_DELAY_S=0.8
CHAT_TEMPERATURE=0.2
CHAT_MAX_OUTPUT_TOKENS=800
CHAT_CONTEXT_CHUNK_MAX_CHARS=1400
CHAT_HISTORY_TURNS=6
CHAT_HISTORY_TABLE=chat_messages

# Observability & Development
DEBUG_TRACE=true
TRACE_DIR=./traces
LOG_DIR=./logs
ENABLE_QUERY_ROUTER=false

# ─── Hybrid Retrieval Pipeline ────────────────────────────────────────────────
# Master switch — set true to activate hybrid (semantic + keyword + RRF) mode.
# When false (default), existing pure-semantic retrieval is used unchanged.
# REQUIRED: run sql/fts_setup.sql and sql/fts_rpc.sql in Supabase before enabling.
HYBRID_RETRIEVAL_ENABLED=true

# ─── Optional: Cross-Encoder Reranking ────────────────────────────────────────
# Requires: pip install sentence-transformers (not in default requirements.txt)
# When enabled, replaces BM25 reranking in the hybrid retrieval pipeline.
# Falls back to BM25 automatically if model load fails or inference times out.
RERANK_CROSS_ENCODER_ENABLED=false
RERANK_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CROSS_ENCODER_TIMEOUT_S=5.0
RERANK_CROSS_ENCODER_LIMIT=20

# Semantic search (pgvector)
RETRIEVAL_SEMANTIC_TOP_K=20
RETRIEVAL_SEMANTIC_THRESHOLD=0.0

# Keyword search (PostgreSQL full-text search)
# Requires running sql/fts_setup.sql in Supabase first.
RETRIEVAL_KEYWORD_ENABLED=true
RETRIEVAL_KEYWORD_TOP_K=20
RETRIEVAL_KEYWORD_MIN_TS_RANK=0.0

# Reciprocal Rank Fusion
RETRIEVAL_RRF_K=60
RETRIEVAL_FUSION_TOP_K=20

# Reranking
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_RERANK_TOP_K=5

# Final output
RETRIEVAL_FINAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.2
RETRIEVAL_MIN_RERANK_SCORE=0.05

# ─── Phase B3: Knowledge Base + Multi-tenant ──────────────────────────────────
# Knowledge table names (defaults are fine — only override for multi-env setups)
B3_KNOWLEDGE_ARTICLES_TABLE=rag_knowledge_articles
B3_KNOWLEDGE_CHUNKS_TABLE=rag_knowledge_chunks
B3_REVIEW_QUEUE_TABLE=rag_review_queue

# Retrieval quality gate: chunks with quality_score < this value are excluded
B3_KNOWLEDGE_MIN_QUALITY_SCORE=0.40

# Similarity boosts applied in match_all_b1_sources (must match SQL migration values)
B3_KNOWLEDGE_SIMILARITY_BOOST=0.08
B3_KNOWLEDGE_QUALITY_BONUS_MAX=0.05

# Minimum character length for a knowledge chunk to be embedded
B3_KNOWLEDGE_MIN_CHUNK_CHARS=100

# Path to the Stack Overflow Teams export directory (More_data/)
# Use absolute path or relative to the service root
B3_KNOWLEDGE_SOURCE_DIR=../More_data

# Optional: override tag→client mapping JSON file
# B3_TENANT_MAP_PATH=./data/config/tenant_map.json

# ─── Phase B3: Asana Integration (optional — graceful degradation if not set) ──
# ASANA_API_KEY=
# ASANA_PROJECT_ID=
# ASANA_WORKSPACE_ID=
