# =============================================================================
# Phase B1 Environment Template
# Copy to .env and fill in values before running the ingestion pipeline.
#
# Required: Supabase credentials (shared with existing app/.env)
# Required: OpenAI API key for embeddings
# =============================================================================

# ── Existing app settings (copy from .env.example) ───────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=https://api.openai.com/v1

OPENAI_CHAT_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Phase B1 specific settings ────────────────────────────────────────────────

# Table names (change only if you need multiple environments)
B1_TICKET_DOCUMENTS_TABLE=rag_ticket_documents
B1_TICKET_CHUNKS_TABLE=rag_ticket_chunks
B1_SOP_LIBRARY_TABLE=rag_sop_library
B1_SOP_CHUNKS_TABLE=rag_sop_chunks
B1_INGESTION_LOGS_TABLE=rag_ingestion_logs
B1_INGESTION_ERRORS_TABLE=rag_ingestion_errors
B1_FEEDBACK_LOGS_TABLE=rag_feedback_logs

# Data paths (relative to service root or absolute)
# B1_PROCESSED_DATA_DIR=./data/processed
# B1_REPORTS_DIR=./data/reports

# Index version — bump to v2 to rebuild cleanly without deleting old chunks
B1_INDEX_VERSION=v1

# ── Chunking tuning ───────────────────────────────────────────────────────────
B1_TICKET_MIN_CHUNK_WORDS=30
B1_TICKET_MAX_CHUNK_WORDS=400
B1_TICKET_OVERLAP_WORDS=20
B1_MIN_QUERY_BODY_CHARS=80

# ── Embedding tuning ──────────────────────────────────────────────────────────
B1_EMBEDDING_BATCH_SIZE=64
B1_EMBEDDING_MAX_RETRIES=5
B1_EMBEDDING_RETRY_BASE_DELAY_S=1.0
B1_EMBEDDING_RETRY_MAX_DELAY_S=30.0

# ── Retrieval defaults ────────────────────────────────────────────────────────
B1_DEFAULT_TOP_K=10
B1_DEFAULT_SIMILARITY_THRESHOLD=0.27
B1_SOP_SIMILARITY_BOOST=0.15
B1_EXCLUDE_ESCALATION_FROM_AUTO=true

# ── Ingestion safety limits ───────────────────────────────────────────────────
B1_MAX_BATCH_ERRORS=10
B1_UPSERT_BATCH_SIZE=50

# ── Observability ─────────────────────────────────────────────────────────────
B1_LOG_LEVEL=INFO
B1_LOG_TO_FILE=true
B1_METRICS_FLUSH_INTERVAL_S=60
LOG_LEVEL=INFO
