# ── Python & Cache ───────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.junit.xml

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/

# ── Secrets & credentials (local env files) ──────────────────
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json
credentials.json
service_account.json

# ── Local runtime artifacts (traces, logs, temp, cache) ──────
logs/
traces/
*.log
*.log.*
*_log.txt
error_log.txt
ingest_log.txt
tmp/
*.tmp
temp/
evaluation_outputs/
embeddings_cache/
.docker-compose.override.yml
docker-compose.override.yml

# ── Generated data artifacts (runtime outputs — not source) ──
data/processed/*.parquet
data/processed/*.csv
data/processed/*.pkl
data/reports/*.json
data/reports/*.md
data/fumadocs_repo/
data/raw/

# ── Development / debug scripts (one-off, not for production) ─
check_db.py
count_tokens_check.py
debug_*.py
test_local_*.py

# ── Benchmark outputs (may contain PII — ticket query text) ───
benchmark_results*.json
regression_report*.md
before_vs_after.json
*_benchmark_*.json
before.json
after.json

# ── IDE & editor ─────────────────────────────────────────────
.idea/
.vscode/
.claude/
.cursor/

# ── OS artifacts ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# IMPORTANT:
# - Do NOT ignore sql/ migrations
# - Do NOT ignore SOP examples
# - Do NOT ignore validation datasets
# - Do NOT ignore important configs
!sql/
!data/sop_examples/
!data/validation_datasets/